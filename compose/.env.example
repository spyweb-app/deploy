# Copy to .env next to the compose files and edit.
# Commented = not set = default. Never leave a var empty (an empty value
# still counts as set).

# ── SpyWeb ──────────────────────────────────────────────────────────────────
# which image tag: latest (KV) | latest-sql (SQL) | <version> | <version>-sql
#SPYWEB_TAG=latest
#SPYWEB_PORT=7979
SPYWEB_API_KEY=change-me
#SPYWEB_LOG=info
#SPYWEB_THREADS=2
# set to 1 for scraping only (no dashboard/API).
# Presence-triggered: ANY value (0, false, even empty) disables - keep the
# line commented out to run the server.
#SPYWEB_DISABLE_SERVER=1

# ── Uptyme (read by the image's config.lua via env_get -> SPYWEB_ prefix) ──
#UPTYME_TAG=latest
# standalone (default) | central | checker
#SPYWEB_MODE=standalone
#SPYWEB_ROLE=checker
# checker: also uncomment SPYWEB_DISABLE_SERVER (SpyWeb section above) - a
# checker only reports to central, it needs no local dashboard
#SPYWEB_CENTRAL_URL=https://central.example.com
#SPYWEB_AUTH_TOKEN=node-key-from-central
#SPYWEB_NODE_NAME=vps-1
# file (default) | terminal | both | none
#SPYWEB_LOG_OUTPUT=file
